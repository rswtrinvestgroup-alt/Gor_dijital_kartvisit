# BotFather token (zorunlu)
TELEGRAM_BOT_TOKEN=

# OpenAI — AI sohbet için (opsiyonel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Production webhook (Render/Railway hosting sonrası)
# Örnek: https://gor-bot.onrender.com
WEBHOOK_URL=

# Sunucu portu (hosting sağlar, genelde 8080 veya 10000)
PORT=8080

# Yeni sipariş/rehber talebi bildirimi (Telegram user ID'niz)
# @userinfobot ile öğrenin
ADMIN_CHAT_ID=
